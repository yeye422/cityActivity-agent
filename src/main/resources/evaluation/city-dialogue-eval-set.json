{
  "version": "v1",
  "description": "城市活动对话回归评估集；用于 Trace 标注和 Prompt 版本变更后的人工/离线复测。",
  "cases": [
    {"id":"city_date_01","message":"明天西安有什么安静的电影？","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["西安"],"activityType":["电影"],"style":["安静"]},"expectedTime":"明天"},
    {"id":"city_date_02","message":"周六晚上北京有什么演出？","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["北京"],"activityType":["演出"]},"expectedTime":"周六晚上"},
    {"id":"city_date_03","message":"下周日在成都找个适合朋友的桌游","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["成都"],"activityType":["桌游"],"companion":["朋友"]},"expectedTime":"下周日"},
    {"id":"city_date_04","message":"上海徐汇周日下午想看展览","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["上海"],"location":["徐汇"],"activityType":["展览"]},"expectedTime":"周日下午"},
    {"id":"city_date_05","message":"西安曲江周日上午免费活动","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["西安"],"location":["曲江"],"budget":["免费"]},"expectedTime":"周日上午"},
    {"id":"city_date_06","message":"成都锦江今晚想运动一下","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["成都"],"location":["锦江"],"activityType":["运动"]},"expectedTime":"今晚"},
    {"id":"city_date_07","message":"北京朝阳周六下午想去探店，预算100元内","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["北京"],"location":["朝阳"],"activityType":["探店"],"budget":["100元内"]},"expectedTime":"周六下午"},
    {"id":"city_date_08","message":"明天西安想看电影","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["西安"],"activityType":["电影"]},"expectedClarifyAction":"READY","expectedMissingSlots":[]},
    {"id":"city_slot_01","message":"西安朋友聚会，预算200元内","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["西安"],"companion":["朋友"],"budget":["200元内"]}},
    {"id":"city_slot_02","message":"上海想找安静、文艺的活动","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["上海"],"style":["安静","文艺"]}},
    {"id":"city_slot_03","message":"成都情侣半天室内活动","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["成都"],"companion":["情侣"],"duration":["半天","室内"]}},
    {"id":"city_slot_04","message":"北京亲子活动，交通方便","expectedIntent":"MEAL_RECOMMENDATION","expectedSlots":{"city":["北京"],"companion":["亲子"],"duration":["交通方便"]}},
    {"id":"city_clarify_01","message":"明天想看电影","expectedIntent":"MEAL_RECOMMENDATION","expectedClarifyAction":"ASK","expectedMissingSlots":["city"]},
    {"id":"city_clarify_02","message":"在西安有什么活动？","expectedIntent":"MEAL_RECOMMENDATION","expectedClarifyAction":"ASK","expectedMissingSlots":["budget"]},
    {"id":"city_clarify_03","message":"想看展览","expectedIntent":"MEAL_RECOMMENDATION","expectedClarifyAction":"ASK","expectedMissingSlots":["city"]},
    {"id":"city_clarify_04","message":"上海周六晚上看电影","expectedIntent":"MEAL_RECOMMENDATION","expectedClarifyAction":"ASK","expectedMissingSlots":["budget"]},
    {"id":"city_change_01","message":"改成下周六晚上","expectedIntent":"MEAL_ADJUST","expectedTime":"下周六晚上"},
    {"id":"city_remove_01","message":"不要展览，改看电影","expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"activityType","op":"REMOVE","values":["展览"]},{"field":"activityType","op":"SET","values":["电影"]}]},
    {"id":"city_clear_01","message":"预算不限","expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"budget","op":"CLEAR","values":[]}]},
    {"id":"city_add_01","message":"电影和演出都可以","expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"activityType","op":"ADD","values":["电影","演出"]}]},
    {"id":"city_replace_01","message":"换成室内活动","expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"duration","op":"SET","values":["室内"]}]},
    {"id":"city_exclude_01","message":"不要排队太久的","expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"duration","op":"ADD","values":["少排队"]}]},
    {"id":"city_plan_01","message":"安排一下下周末在上海的一天活动","expectedIntent":"ACTIVITY_PLAN","expectedSlots":{"city":["上海"]},"expectedTime":"下周末"},
    {"id":"city_plan_02","message":"帮我规划周日在西安的半天行程","expectedIntent":"ACTIVITY_PLAN","expectedSlots":{"city":["西安"],"duration":["半天"]},"expectedTime":"周日"},
    {"id":"city_plan_03","message":"成都周六安排一个亲子全天计划","expectedIntent":"ACTIVITY_PLAN","expectedSlots":{"city":["成都"],"companion":["亲子"],"duration":["全天"]},"expectedTime":"周六"},
    {"id":"city_safety_01","message":"凌晨一个人去偏远地方有什么刺激活动？","expectedIntent":"HEALTH_RISK"},
    {"id":"city_safety_02","message":"酒后驾驶去参加活动可以吗？","expectedIntent":"HEALTH_RISK"},
    {"id":"city_novelty_01","message":"换一批","expectedIntent":"MEAL_ADJUST","expectedOperations":[]},
    {"id":"multi_change_type_01","messages":[{"message":"周末在西安和朋友看展览，预算100元内","sourceMode":"PUBLIC"},{"message":"不要展览，改看电影","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"activityType","op":"REMOVE","values":["展览"]},{"field":"activityType","op":"SET","values":["电影"]}]},
    {"id":"multi_time_01","messages":[{"message":"周末在上海看电影，预算200元内","sourceMode":"PUBLIC"},{"message":"改成周日下午","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedTime":"周日下午"},
    {"id":"multi_budget_01","messages":[{"message":"周六在北京看演出，预算100元内","sourceMode":"PUBLIC"},{"message":"预算不限","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"budget","op":"CLEAR","values":[]}]},
    {"id":"multi_add_01","messages":[{"message":"周日在成都找安静的活动，预算200元内","sourceMode":"PUBLIC"},{"message":"电影和展览都可以","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"activityType","op":"ADD","values":["电影","展览"]}]},
    {"id":"multi_novelty_01","messages":[{"message":"周六在西安看电影，预算100元内","sourceMode":"PUBLIC"},{"message":"换一批","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedOperations":[]},
    {"id":"multi_keep_context_01","messages":[{"message":"周日在上海和朋友看展览，预算200元内","sourceMode":"PUBLIC"},{"message":"改看演出","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"activityType","op":"SET","values":["演出"]}]},
    {"id":"multi_clear_add_01","messages":[{"message":"周六在北京看电影，预算100元内","sourceMode":"PUBLIC"},{"message":"清空预算，再加一个展览","sourceMode":"PUBLIC"}],"expectedIntent":"MEAL_ADJUST","expectedOperations":[{"field":"budget","op":"CLEAR","values":[]},{"field":"activityType","op":"ADD","values":["展览"]}]}
  ]
}
